<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:ValoCord.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ValoCord.UserControls.Components.StandingPill">
    <Design.DataContext>
        <viewModels:VODListItemViewModel/>
    </Design.DataContext>
    <Border CornerRadius="25" Width="70">
        <Border.Background>
            <SolidColorBrush Color="{Binding Standing, Converter={StaticResource StandingToColorConverter}}"/>
        </Border.Background>
        <TextBlock TextAlignment="Center" Text="{Binding Standing}"/>
    </Border>
</UserControl>
