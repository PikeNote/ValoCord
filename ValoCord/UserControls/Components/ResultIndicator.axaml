<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:ValoCord.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ValoCord.UserControls.Components.ResultIndicator">
    <Design.DataContext>
        <viewModels:VODListItemViewModel></viewModels:VODListItemViewModel>
    </Design.DataContext>
    <Border Width="6" VerticalAlignment="Stretch" Background="#7AC343" CornerRadius="10 0 0 10">
        <Interaction.Behaviors>
            <DataTriggerBehavior Binding="{Binding TeamWon}" ComparisonCondition="Equal" Value="Won">
                <ChangePropertyAction PropertyName="Background" Value="#7AC343" />
            </DataTriggerBehavior>
            <DataTriggerBehavior Binding="{Binding TeamWon}" ComparisonCondition="Equal" Value="Lost">
                <ChangePropertyAction PropertyName="Background" Value="#cc0000" />
            </DataTriggerBehavior>
            <DataTriggerBehavior Binding="{Binding TeamWon}" ComparisonCondition="Equal" Value="Draw">
                <ChangePropertyAction PropertyName="Background" Value="#FFEE8C" />
            </DataTriggerBehavior>
        </Interaction.Behaviors>
    </Border>
</UserControl>
