<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ValoCord"
             x:Class="ValoCord.App"
             xmlns:sty = "using:FluentAvalonia.Styling"
             xmlns:converters="clr-namespace:ValoCord.Converters"
             RequestedThemeVariant="Dark">
    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
    <Application.Resources>
        <converters:StandingToColorConverter x:Key="StandingToColorConverter"/>
    </Application.Resources>
    <Application.Styles>
        <sty:FluentAvaloniaTheme PreferUserAccentColor="True"/>
        <StyleInclude Source="avares://FluentAvalonia.ProgressRing/Styling/Controls/ProgressRing.axaml" />
        <FluentTheme/>
    </Application.Styles>
</Application>
