<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:userControls="clr-namespace:ValoCord.UserControls"
             xmlns:viewModels="clr-namespace:ValoCord.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ValoCord.Views.HomeView"
             x:DataType="viewModels:HomeViewModel">
    <Design.DataContext>
        <viewModels:HomeViewModel/>
    </Design.DataContext>
    <StackPanel>
        <TextBlock Text="Latest Valorant News"/>
        <ItemsControl Grid.Column="1" ItemsSource="{Binding RecentPatches}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <userControls:NewsItem/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
