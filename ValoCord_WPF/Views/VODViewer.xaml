<ui:FluentWindow x:Class="ValoCord_WPF.Views.VODViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:ValoCord_WPF.Views"
        xmlns:handlers="clr-namespace:ValoCord_WPF.Handlers"
        xmlns:wpf="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:viewModels="clr-namespace:ValoCord_WPF.ViewModels"
        xmlns:userControls="clr-namespace:ValoCord_WPF.UserControls"
        xmlns:converters="clr-namespace:ValoCord_WPF.Converters"
        x:Name="VodViewerPage"
        xmlns:ffme="clr-namespace:Unosquare.FFME;assembly=ffme.win"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        d:DataContext="{d:DesignInstance Type=viewModels:VODViewerViewModel,IsDesignTimeCreatable=True}"
        Closing="Window_OnClosing"
        ResizeMode="CanResize"
        MinHeight="965" MinWidth="1700"
        Background="Black" WindowCornerPreference="Round">
    <Window.Resources>
        <converters:ComparisonConverter x:Key="ComparisonConverter" />
        <converters:TimeFormatConverter x:Key="TimeFormatConverter"/>
    </Window.Resources>
    <Grid handlers:GridSpacingHelper.RowSpacing="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar 
            Title="ValoCord - VOD Recording Software for VALORANT" FontSize="14">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/Logo.png" Width="18" Height="18"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>
    
        <StackPanel Margin="10" Grid.Row="1">
            <StackPanel Orientation="Horizontal" handlers:SpacingSetter.Spacing="10">
                <TextBlock FontSize="20" VerticalAlignment="Center" >Match Details</TextBlock>
                <TextBlock VerticalAlignment="Center" Text="{Binding GameTime}"/>
            </StackPanel>
            <TextBlock FontSize="15" Text="{Binding GameDescription}"/>
        </StackPanel>
    
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              Margin="10" Grid.Row="2">
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            

            <Grid Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <ffme:MediaElement x:Name="Media" Background="Transparent" LoadedBehavior="Pause" UnloadedBehavior="Manual" 
                                   Grid.Row="0" HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   ScrubbingEnabled="True"
                                   Position="{Binding MediaPosition, Mode=TwoWay}"
                                   MediaOpened="Media_OnMediaOpened"/>
                
                <StackPanel Grid.Row="0" 
                       Background="#1C1C1C"
                       Visibility="Collapsed"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       handlers:SpacingSetter.Spacing="10"
                       >
                    <ui:ProgressRing IsIndeterminate="True" BorderThickness="10" Width="150" Height="150" HorizontalAlignment="Center" />
                    <TextBlock Text="Loading Video..." HorizontalAlignment="Center" />
                </StackPanel>
                
                <StackPanel Grid.Row="1"
                            Orientation="Vertical"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Stretch"
                            Margin="0,10,0,0" >
                    
                    <Slider Maximum="{Binding ElementName=Media, Path=NaturalDuration.TotalMilliseconds, FallbackValue=1}"
                            Minimum="0"
                            FocusVisualStyle="{x:Null}"
                            IsEnabled="{Binding !IsLoaded, ElementName=Media}"
                            Value="{Binding ElementName=Media, Path=Position.TotalMilliseconds, Mode=OneWay}"
                            SmallChange="0.005"
                            LargeChange="0.05"
                            IsMoveToPointEnabled="True"

                            PreviewMouseLeftButtonUp="VideoProgress_PreviewMouseUp"
                            PreviewMouseLeftButtonDown="VideoProgress_PreviewMouseDown"
                            ValueChanged="VideoProgress_ValueChanged"

                            x:Name="VideoProgress"
                    />
                    <Grid Margin="5,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding ElementName=Media, Path=Position.TotalMilliseconds, Converter={StaticResource TimeFormatConverter}}"
                                   Foreground="White"
                                   FontSize="12" />

                        <TextBlock Grid.Column="2"
                                   Text="{Binding ElementName=Media, Path=NaturalDuration.TotalMilliseconds, Converter={StaticResource TimeFormatConverter}}"
                                   Foreground="White"
                                   FontSize="12"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Grid.Row="0"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Center"
                                handlers:SpacingSetter.Spacing="20">
                        <ui:SymbolIcon Symbol="ArrowPrevious24" FontSize="30" Foreground="White"/>
                        <Button Command="{Binding TogglePlayPauseCommand}"
                                CommandParameter="{Binding ElementName=Media}" Background="Transparent"
                                BorderThickness="0"
                                Foreground="White" FontSize="30" >
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <ui:SymbolIcon Symbol="Play28"/>
                                        </Setter.Value>
                                    </Setter>
            
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=Media, Path=MediaState}" Value="Play">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <ui:SymbolIcon Symbol="Pause28" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <ui:SymbolIcon Symbol="ArrowNext24" FontSize="30" Foreground="White" />
                    </StackPanel>
                                            
                </StackPanel>
                
            </Grid>
            <ItemsControl Grid.Column="1" ItemsSource="{Binding CurrentRound.RoundEvents}">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Background="#171717" Grid.Column="1" 
                                    VerticalAlignment="Stretch" 
                                    HorizontalAlignment="Stretch" Margin="10 0 10 0" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <userControls:EventItem/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        
        </Grid>
        <ItemsControl ItemsSource="{Binding RoundDataList}" HorizontalAlignment="Stretch" Grid.Row="3" >
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding RoundDataList.Count}" 
                                 HorizontalAlignment="Stretch" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button BorderThickness="2.5" 
                            BorderBrush="#171717" HorizontalAlignment="Stretch" 
                            VerticalAlignment="Stretch"
                            Command="{Binding DataContext.RoundChangedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding RoundNumber}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#f35a57" />
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{StaticResource ComparisonConverter}">
                                                <Binding Path="TeamWon" />
                                                <Binding Path="DataContext.TeamWon" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="Background" Value="#66c2a9"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding RoundNumber}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" TextAlignment="Center"/>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</ui:FluentWindow>
