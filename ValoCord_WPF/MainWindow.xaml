<ui:FluentWindow x:Class="ValoCord_WPF.MainWindow"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:local="clr-namespace:ValoCord_WPF"
              mc:Ignorable="d"
              Title="MainWindow"
              xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
              xmlns:viewModels="clr-namespace:ValoCord_WPF.ViewModels"
              xmlns:handlers="clr-namespace:ValoCord_WPF.Handlers"
              xmlns:views="clr-namespace:ValoCord_WPF.Views"
              xmlns:converters="clr-namespace:ValoCord_WPF.Converters"
              Background="#FF202020"
              d:DataContext="{d:DesignInstance viewModels:MainWindowViewModel}"
              WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:BooleanToVisibilityConverter 
            x:Key="BooleanToVisibilityConverter" 
            True="Collapsed" 
            False="Visible" />
    </ui:FluentWindow.Resources>
    <Grid VerticalAlignment="Stretch"
          HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar 
                     Title="ValoCord - VOD Recording Software for VALORANT" FontSize="14">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/Logo.png" Width="18" Height="18"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <ui:NavigationView Grid.Row="1" x:Name="RootNavigation" MenuItemsSource="{Binding NavigationItems}"
                           IsBackButtonVisible="Collapsed"

                           VerticalAlignment="Stretch"
                           HorizontalAlignment="Stretch"
                           Background="{DynamicResource LayerFillColorDefaultBrush}"
                           FontFamily="Inter"
        >
            
            
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem IsEnabled="False" Padding="0">
                    
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="●" VerticalAlignment="Center"
                                  FontSize="27"
                                  Foreground="{Binding Source={x:Static handlers:ProgramStatusHandler.Instance}, Path=StatusColorBrush}"
                                  Visibility="{Binding Path=IsPaneOpen, Converter={StaticResource BooleanToVisibilityConverter}, ElementName=RootNavigation}"/>
                    </ui:NavigationViewItem.Icon>
                    
                    <StackPanel HorizontalAlignment="Center" Margin="0 0 0 10">
                        
                        <TextBlock Text="ValoCord v1.0.0"
                                   Margin="12"
                                   HorizontalAlignment="Center"
                                   Visibility="{Binding Path=IsPaneOpen, Converter={StaticResource BoolToVisibility}, ElementName=RootNavigation}"/>
                        
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Recording Status:"
                                       HorizontalAlignment="Center"
                                       Visibility="{Binding Path=IsPaneOpen, Converter={StaticResource BoolToVisibility}, ElementName=RootNavigation}"/>
                            <Border CornerRadius="180" Width="13" Height="13" Margin="5 0 3 0" Background="{Binding Source={x:Static handlers:ProgramStatusHandler.Instance}, Path=StatusColorBrush}"/>
                            <TextBlock Text="{Binding Source={x:Static handlers:ProgramStatusHandler.Instance}, Path=StatusMessage}"
                                       HorizontalAlignment="Center"
                                       Visibility="{Binding Path=IsPaneOpen, Converter={StaticResource BoolToVisibility}, ElementName=RootNavigation}"/>
                        </StackPanel>
                    </StackPanel>
                </ui:NavigationViewItem>
                
                <ui:NavigationViewItem Content="Settings" TargetPageType="{x:Type views:Settings}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

            </ui:NavigationView.FooterMenuItems>

        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
