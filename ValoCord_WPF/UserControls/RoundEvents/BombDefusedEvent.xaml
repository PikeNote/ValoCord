<UserControl x:Class="ValoCord_WPF.UserControls.BombDefusedEvent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ValoCord_WPF.UserControls"
             xmlns:handlers="clr-namespace:ValoCord_WPF.Handlers"
             xmlns:views="clr-namespace:ValoCord_WPF.Views"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="100" d:DesignWidth="600"
             >
    <UserControl.Background>
        <LinearGradientBrush StartPoint="0 0" EndPoint="1 1">
            <LinearGradientBrush.GradientStops>
                <GradientStop Offset="0" Color="#32efeeb2" />
                <GradientStop Offset="0.7" Color="Transparent" />
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>
    </UserControl.Background>
    <Grid Height="50" HorizontalAlignment="Stretch" handlers:GridSpacingHelper.ColumnSpacing="5" Margin="0 10 0 10 ">
        
        
        
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2.5*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1.75*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Center"
                    handlers:SpacingSetter.Spacing="10">
            <Image Source="/Assets/KillFeed/Spike.png" Width="30" RenderOptions.BitmapScalingMode="LowQuality"/>
            <TextBlock Text="Spike Defused" Foreground="White" FontSize="20" VerticalAlignment="Center"/>
        </StackPanel>
        
        <Border Grid.Column="3" 
                ClipToBounds="True" 
                CornerRadius="180" 
                BorderBrush="White" 
                BorderThickness="2" 
                Width="40" Height="40"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center">
            <Button Command="{Binding ChangeTimeCommand, RelativeSource={RelativeSource AncestorType=views:VODViewer}}"
                    Padding="0" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    CommandParameter="{Binding}">
                <ui:SymbolIcon Symbol="Play24" FontSize="25" Foreground="White" />
            </Button>
        </Border>

    </Grid>
</UserControl>
