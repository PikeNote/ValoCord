<UserControl x:Class="ValoCord_WPF.UserControls.Components.StandingPill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ValoCord_WPF.UserControls.Components"
             xmlns:viewModels="clr-namespace:ValoCord_WPF.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance viewModels:VODListItemViewModel}">
    <Border CornerRadius="10" Width="70" Background="{Binding Standing, Converter={StaticResource StandingToColorConverter}}">
        <TextBlock TextAlignment="Center" Text="{Binding Standing}"/>
    </Border>
</UserControl>
