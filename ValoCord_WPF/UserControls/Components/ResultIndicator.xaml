<UserControl x:Class="ValoCord_WPF.UserControls.Components.ResultIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ValoCord_WPF.UserControls.Components"
             xmlns:viewModels="clr-namespace:ValoCord_WPF.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance Type=viewModels:VODListItemViewModel,IsDesignTimeCreatable=True}">
    <Border Width="6" VerticalAlignment="Stretch" Background="#7AC343" CornerRadius="10 0 0 10">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding TeamWon}" Value="Won">
                        <Setter Property="Background" Value="#7AC343" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding TeamWon}" Value="Lost">
                        <Setter Property="Background" Value="#cc0000" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding TeamWon}" Value="Draw">
                        <Setter Property="Background" Value="#FFEE8C" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
    </Border>
</UserControl>
