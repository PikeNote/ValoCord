<UserControl x:Class="ValoCord_WPF.UserControls.MiniVODListItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ValoCord_WPF.UserControls"
             xmlns:viewModels="clr-namespace:ValoCord_WPF.ViewModels"
             xmlns:components="clr-namespace:ValoCord_WPF.UserControls.Components"
             xmlns:handlers="clr-namespace:ValoCord_WPF.Handlers"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance Type=viewModels:VODListItemViewModel,IsDesignTimeCreatable=True}">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="h2">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>    
    </UserControl.Resources>
    <Border CornerRadius="10"  HorizontalAlignment="Stretch">
        <Button Click="ButtonBase_OnClick" Background="Transparent" BorderThickness="0" >
            <Border Background="#211F1F" CornerRadius="10"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0" Height="95" ClipToBounds="True"> 
                <Grid VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="110"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <components:ResultIndicator Grid.Column="0"/>
                    <Grid Grid.Column="1">
                        <Image
                            Source="{Binding MapImage}"
                            Stretch="UniformToFill"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" 
                        />
                        <Rectangle
                            Fill="#80000000"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />
                            
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center" TextAlignment="Center" Style="{StaticResource h2}" Text="{Binding Score}"/>
                    </Grid>
                    <Grid Grid.Column="2" Margin="10 10 30 10" handlers:GridSpacingHelper.RowSpacing="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource h2}">
                            <Run Text="{Binding MapName, Mode=OneWay}"/>
                            <Run Text="("/>
                            <Run Text="{Binding GameMode, Mode=OneWay}"/>
                            <Run Text=")"/>
                        </TextBlock>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" handlers:SpacingSetter.Spacing="5">
                            <TextBlock Text="{Binding Date}"/>
                            <components:StandingPill/>
                        </StackPanel>
                        <Grid Grid.Row="2" handlers:GridSpacingHelper.ColumnSpacing="8" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0" Source="{Binding AgentIcon}" Width="30" RenderOptions.BitmapScalingMode="LowQuality"/>
                            <TextBlock Grid.Column="1" Text="{Binding kda}" VerticalAlignment="Center"></TextBlock>
                            <TextBlock Grid.Column="2"  Foreground="White" VerticalAlignment="Center" Text="{Binding CombatScore}"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
    </Button>
    </Border>
</UserControl>
