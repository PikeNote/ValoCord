<Application x:Class="ValoCord_WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ValoCord_WPF"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:ValoCord_WPF.Converters">
    <Application.Resources>
        <ResourceDictionary x:Key="ResourceDictionary">
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="/Themes/Dark.xaml" />

            </ResourceDictionary.MergedDictionaries>
            <converters:StandingToColorConverter x:Key="StandingToColorConverter"/>
            <converters:StringImageUrlConverter x:Key="StringImageUrlConverter"/>
            <Style TargetType="{x:Type Control}">
                <Setter Property="FontFamily" Value="./Assets/Fonts/Inter.ttf#Inter" />
            </Style>

            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="./Assets/Fonts/Inter.ttf#Inter" />
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="16"/>
            </Style>
            
        </ResourceDictionary>

    </Application.Resources>
</Application>
